# =============================================================================
# Smart Approval Flow — Example Environment
# Copy this file to `.env` and fill in the values. Never commit real secrets.
# Each app also has its own .env.example (apps/api, apps/web) with a subset.
# =============================================================================

# --- Shared -----------------------------------------------------------------
NODE_ENV=development

# --- Database (Postgres) ----------------------------------------------------
# Used by packages/db (Prisma) and apps/api.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_approval_flow?schema=public

# --- API (apps/api, Fastify) ------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
# Public base URL of the API, used in OpenAPI servers list and link building.
API_BASE_URL=http://localhost:4000

# Secret used to sign session / access tokens (JWT). Generate a long random string.
AUTH_JWT_SECRET=change-me-to-a-long-random-string

# Base URL of the customer-facing web app, used to build public approval links
# of the form: {WEB_BASE_URL}/a/{token}
WEB_BASE_URL=http://localhost:3000

# --- Web (apps/web, Next.js) ------------------------------------------------
WEB_PORT=3000
# URL the web app uses to reach the API (server-side).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# --- Notifications (prepared for Block 4, not active in Block 1) -------------
# EMAIL_PROVIDER=console
# EMAIL_FROM=freigabe@example-garage.ch
# SMS_PROVIDER=disabled

# --- File storage (prepared for Block 2 photo uploads) ----------------------
# STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=./.uploads
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
