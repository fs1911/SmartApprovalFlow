# =============================================================================
# Smart Approval Flow — Environment reference (SINGLE SOURCE)
#
# Copy to `.env` and fill in as needed. Never commit real secrets.
# Each app also has its own .env.example (apps/api, apps/web) with its subset.
#
# EVERYTHING runs locally with NO external credentials using the defaults below
# (console e-mail + local storage + dev auth). Cloud providers are opt-in and
# marked "TODO PROVIDER SETUP" — set their vars to activate them.
# See docs/env-and-secrets.md and docs/infrastructure.md.
# =============================================================================

# --- Shared -----------------------------------------------------------------
NODE_ENV=development

# --- Database (Postgres) ----------------------------------------------------
# Local Postgres by default. In production this is typically a Supabase
# connection string. Used by packages/db (Prisma) and apps/api.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_approval_flow?schema=public

# --- API (apps/api, Fastify) ------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
# Public base URL of the API (OpenAPI servers list, link/URL building).
API_BASE_URL=http://localhost:4000

# Secret used to sign session / access tokens (JWT). Long random string.
AUTH_JWT_SECRET=change-me-to-a-long-random-string
# Access-token lifetime (jose duration string, e.g. "12h", "30m").
AUTH_SESSION_TTL=12h

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
RATE_LIMIT_PUBLIC_MAX=30
RATE_LIMIT_LOGIN_MAX=10

# --- Webhooks ---------------------------------------------------------------
# Max delivery attempts before a webhook delivery is marked FAILED.
WEBHOOK_MAX_ATTEMPTS=5

# --- Reminder policy (Block 8) ----------------------------------------------
# Automatic reminders for cases still awaiting a customer response. Triggered on
# demand via POST /api/v1/reminders/run (no cron dependency — see docs/reminders.md).
REMINDER_ENABLED=true
REMINDER_FIRST_AFTER_HOURS=24
REMINDER_REPEAT_EVERY_HOURS=48
REMINDER_MAX=3

# --- Attachments (Block 8) --------------------------------------------------
# Max upload size in bytes re-checked server-side when the photo arrives (15 MB).
ATTACHMENT_MAX_BYTES=15728640

# Base URL of the customer-facing web app, used to build public approval links
# of the form: {WEB_BASE_URL}/a/{token}
WEB_BASE_URL=http://localhost:3000

# --- Web (apps/web, Next.js) ------------------------------------------------
WEB_PORT=3000
# URL the web app uses to reach the API (server-side).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Public site URL — canonical/OpenGraph URLs, robots.txt, sitemap.
NEXT_PUBLIC_SITE_URL=https://smartapprovalflow.ch

# --- Notifications / e-mail -------------------------------------------------
# EMAIL_PROVIDER: `console` (default, no creds, logs to API stdout) | `resend`.
# `resend` sends real e-mail ONLY when RESEND_API_KEY is set; otherwise the code
# falls back to console with a warning. `smtp` is reserved (not implemented).
EMAIL_PROVIDER=console
EMAIL_FROM=freigabe@example-garage.ch
# TODO PROVIDER SETUP — create a Resend account + verified sender, then set:
# RESEND_API_KEY=re_...
# SMS is modelled but not transported yet (returns a clear "not enabled" result).
# SMS_PROVIDER=disabled

# --- File storage (attachments) ---------------------------------------------
# STORAGE_DRIVER: `local` (default, filesystem, no creds) | `supabase` | `r2`.
# A cloud driver is used only when its credentials are present; otherwise the
# code falls back to `local` with a warning.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.uploads
# TODO PROVIDER SETUP — Supabase Storage:
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=...
# SUPABASE_STORAGE_BUCKET=attachments
# TODO PROVIDER SETUP — Cloudflare R2:
# R2_ACCOUNT_ID=...
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_BUCKET=attachments
