// =============================================================================
// Smart Approval Flow — Prisma schema (Block 1 foundation)
//
// Design notes:
//  * Multi-tenant by row: almost every business row carries `tenantId`, and all
//    queries are expected to filter by it (see docs/decisions/adr-003).
//  * Enums mirror packages/types/src/enums.ts — keep the two in sync.
//  * The audit trail (AuditEvent) is append-only and never updated/deleted.
//  * ApiKey and OutboundMessage are prepared now but only lightly used until
//    later blocks (integration readiness + notifications).
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums -------------------------------------------------------------------

enum Role {
  OWNER
  ADMIN
  SERVICE_ADVISOR
  TECHNICIAN
  VIEWER
}

enum ApprovalCaseStatus {
  DRAFT
  SENT
  VIEWED
  APPROVED
  PARTIALLY_APPROVED
  DECLINED
  CALLBACK
  EXPIRED
  CANCELLED
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
}

enum ItemCategory {
  SAFETY
  MAINTENANCE
  REPAIR
  DIAGNOSTIC
  OTHER
}

enum CustomerDecision {
  APPROVE
  DECLINE
  CALLBACK
}

enum MessageChannel {
  EMAIL
  SMS
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

enum AuditEventType {
  CASE_CREATED
  CASE_UPDATED
  CASE_SENT
  CASE_REMINDER_SENT
  CASE_LINK_VIEWED
  CASE_APPROVED
  CASE_PARTIALLY_APPROVED
  CASE_DECLINED
  CASE_CALLBACK_REQUESTED
  CASE_EXPIRED
  CASE_CANCELLED
  CASE_ITEM_DECIDED
  CASE_ATTACHMENT_ADDED
  MEMBER_INVITED
  MEMBER_JOINED
  MEMBER_INVITE_REVOKED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PLAN_CHANGED
  DATA_ERASED
  MESSAGE_QUEUED
  MESSAGE_SENT
  MESSAGE_FAILED
}

enum ActorType {
  USER
  CUSTOMER
  SYSTEM
  API_KEY
}

/// Kind of a single-use verification token (Block 10). INVITE onboards a new
/// member; PASSWORD_RESET lets an existing user set a new password.
enum VerificationTokenType {
  INVITE
  PASSWORD_RESET
}

/// Subscription plan tier (Block 11). Limits live in packages/types/plans.ts.
enum PlanKey {
  FREE
  STARTER
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
}

/// Internal (in-app) notification type (Block 14). Mirrors
/// packages/types/enums.ts NOTIFICATION_TYPE.
enum NotificationType {
  CASE_APPROVED
  CASE_PARTIALLY_APPROVED
  CASE_DECLINED
  CASE_CALLBACK
  CASE_EXPIRED
  CASE_ASSIGNED
  CASE_NOTE_ADDED
}

// --- Tenancy & identity ------------------------------------------------------

/// A Tenant is a workspace = one garage / workshop group. Root of isolation.
model Tenant {
  id        String   @id @default(uuid())
  /// URL-safe unique handle, used for workspace selection and (later) subdomains.
  slug      String   @unique
  name      String
  /// White-label branding, used on the public customer page and messages.
  brandName String?
  /// Primary brand colour (hex, e.g. "#1f5fa8") for the public page accent.
  brandColor String?
  /// Public contact shown to customers (for the "questions?" hint).
  contactEmail String?
  contactPhone String?
  locale    String   @default("de-CH")
  timezone  String   @default("Europe/Zurich")
  currency  String   @default("CHF")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships    Membership[]
  users          User[]
  customers      Customer[]
  vehicles       Vehicle[]
  approvalCases  ApprovalCase[]
  attachments    Attachment[]
  auditEvents    AuditEvent[]
  outboundMsgs   OutboundMessage[]
  apiKeys        ApiKey[]
  messageTemplates MessageTemplate[]
  webhookEndpoints WebhookEndpoint[]
  verificationTokens VerificationToken[]
  subscription   Subscription?
  notifications  Notification[]
  caseNotes      CaseNote[]
  voiceCaptures  VoiceCapture[]
  savedViews     SavedView[]

  @@map("tenants")
}

/// One subscription per tenant (Block 11). The plan's concrete limits live in
/// packages/types/plans.ts (server + web share them). Provider references are
/// nullable: the mock/dev provider needs none; Stripe fills them in later.
model Subscription {
  id                     String             @id @default(uuid())
  tenantId               String             @unique
  planKey                PlanKey            @default(PRO)
  status                 SubscriptionStatus @default(ACTIVE)
  /// Anchor of the current usage/billing period (monthly).
  currentPeriodStart     DateTime           @default(now())
  currentPeriodEnd       DateTime?
  /// External provider ids (Stripe). Null in dev/mock. TODO PROVIDER SETUP.
  providerCustomerId     String?
  providerSubscriptionId String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

/// A User belongs to exactly one Tenant in the MVP (see adr-003 for rationale).
model User {
  id           String   @id @default(uuid())
  tenantId     String
  email        String
  name         String
  /// Argon2/bcrypt hash. Null while auth flow is stubbed in Block 1.
  passwordHash String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships Membership[]
  createdCases ApprovalCase[] @relation("CaseCreatedBy")
  assignedCases ApprovalCase[] @relation("CaseAssignee")
  notifications Notification[]
  caseNotes    CaseNote[]
  voiceCaptures VoiceCapture[]
  savedViews   SavedView[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

/// Membership links a User to a Tenant with a Role. Modeled explicitly so the
/// jump to multi-workspace users in a later block is non-breaking.
model Membership {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  role      Role     @default(SERVICE_ADVISOR)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@map("memberships")
}

// --- Customer & vehicle ------------------------------------------------------

model Customer {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicles      Vehicle[]
  approvalCases ApprovalCase[]

  @@index([tenantId])
  @@index([tenantId, email])
  @@map("customers")
}

model Vehicle {
  id         String   @id @default(uuid())
  tenantId   String
  customerId String?
  plate      String?
  vin        String?
  make       String?
  model      String?
  year       Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  approvalCases ApprovalCase[]

  @@index([tenantId])
  @@index([tenantId, plate])
  @@map("vehicles")
}

// --- Approval workflow (the wedge) ------------------------------------------

model ApprovalCase {
  id          String             @id @default(uuid())
  tenantId    String
  /// Human-friendly per-tenant sequence, e.g. "AC-2026-0142". Filled by API.
  reference   String
  subject     String
  description String?
  status      ApprovalCaseStatus @default(DRAFT)
  urgency     Urgency            @default(MEDIUM)

  customerId  String?
  vehicleId   String?
  createdById String?
  /// Optional team member responsible for this case (Block 14).
  assigneeUserId String?

  /// When the case was first sent to the customer.
  sentAt      DateTime?
  /// When the customer first opened the link (mirror of the access link's
  /// firstViewedAt, denormalised onto the case for easy listing/timeline).
  openedAt    DateTime?
  /// When a reminder was last sent, plus how many have gone out.
  lastReminderAt DateTime?
  reminderCount  Int             @default(0)
  /// When the customer submitted a final decision.
  respondedAt DateTime?
  /// Optional expiry for the decision window (drives EXPIRED transition).
  expiresAt   DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer  Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  vehicle   Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  createdBy User?     @relation("CaseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  assignee  User?     @relation("CaseAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)

  items        ApprovalItem[]
  attachments  Attachment[]
  decisions    ApprovalDecision[]
  auditEvents  AuditEvent[]
  outboundMsgs OutboundMessage[]
  notes        CaseNote[]
  notifications Notification[]
  accessLink   ApprovalAccessLink?

  @@unique([tenantId, reference])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, assigneeUserId])
  @@map("approval_cases")
}

/// A single recommended line of work within a case. Named ApprovalItem; the
/// docs also refer to the concept as WorkRecommendation.
model ApprovalItem {
  id             String       @id @default(uuid())
  tenantId       String
  approvalCaseId String
  title          String
  description    String?
  category       ItemCategory @default(REPAIR)
  /// Price band stored as minor units to avoid float rounding issues.
  priceMinMinor  Int?
  priceMaxMinor  Int?
  currency       String       @default("CHF")
  sortOrder      Int          @default(0)
  /// Optional per-item customer decision (Block 8). Null = not individually
  /// decided; the case-level decision still applies. Set when the customer
  /// approves/declines this specific position.
  decision       CustomerDecision?
  decidedAt      DateTime?
  createdAt      DateTime     @default(now())

  approvalCase ApprovalCase       @relation(fields: [approvalCaseId], references: [id], onDelete: Cascade)
  attachments  Attachment[]
  decisions    ApprovalDecision[]

  @@index([approvalCaseId])
  @@map("approval_items")
}

/// A secure, loginless access token for the customer-facing page.
/// Separated from ApprovalCase so tokens can be rotated/revoked and hashed.
model ApprovalAccessLink {
  id             String    @id @default(uuid())
  tenantId       String
  approvalCaseId String    @unique
  /// SHA-256 hash of the opaque token; the raw token is never stored.
  tokenHash      String    @unique
  expiresAt      DateTime?
  revokedAt      DateTime?
  firstViewedAt  DateTime?
  createdAt      DateTime  @default(now())

  approvalCase ApprovalCase @relation(fields: [approvalCaseId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("approval_access_links")
}

/// Immutable record of a customer decision. A case may in theory receive more
/// than one (e.g. CALLBACK then APPROVE); the latest APPROVE/DECLINE is final.
model ApprovalDecision {
  id             String           @id @default(uuid())
  tenantId       String
  approvalCaseId String
  /// Optional: when set, this decision applies to a single position, not the
  /// whole case (Block 8 per-item approval). Null = whole-case decision.
  approvalItemId String?
  decision       CustomerDecision
  note           String?
  callbackPhone  String?
  /// Captured for the revision-proof trail (hashed/truncated in practice).
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime         @default(now())

  approvalCase ApprovalCase  @relation(fields: [approvalCaseId], references: [id], onDelete: Cascade)
  approvalItem ApprovalItem? @relation(fields: [approvalItemId], references: [id], onDelete: SetNull)

  @@index([approvalCaseId])
  @@index([approvalItemId])
  @@map("approval_decisions")
}

// --- Attachments (photos are central) ---------------------------------------

model Attachment {
  id             String  @id @default(uuid())
  tenantId       String
  approvalCaseId String?
  approvalItemId String?
  /// Storage key (S3/local). The actual bytes live outside the DB.
  storageKey     String   @unique
  fileName       String
  contentType    String
  sizeBytes      Int
  /// Two-step upload (Block 8): the row is created first, then the client PUTs
  /// the bytes. `uploadedAt` is stamped once the bytes have arrived; until then
  /// the attachment is "pending" and hidden from the customer view.
  uploadedAt     DateTime?
  createdAt      DateTime @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  approvalCase ApprovalCase? @relation(fields: [approvalCaseId], references: [id], onDelete: Cascade)
  approvalItem ApprovalItem? @relation(fields: [approvalItemId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([approvalCaseId])
  // Supports the orphan-attachment cleanup query (Block 9): never-uploaded rows
  // older than the retention window.
  @@index([tenantId, uploadedAt])
  @@map("attachments")
}

// --- Audit trail (revision-proof) -------------------------------------------

model AuditEvent {
  id             String         @id @default(uuid())
  tenantId       String
  approvalCaseId String?
  type           AuditEventType
  actorType      ActorType
  /// Nullable: SYSTEM/CUSTOMER events have no userId.
  actorUserId    String?
  /// Free-form label for non-user actors, e.g. customer name or "system".
  actorLabel     String?
  /// Arbitrary structured context (diff, channel, etc.) as JSON.
  metadata       Json?
  createdAt      DateTime       @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  approvalCase ApprovalCase? @relation(fields: [approvalCaseId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([approvalCaseId])
  @@map("audit_events")
}

// --- Notifications / outbound messaging -------------------------------------

model OutboundMessage {
  id             String        @id @default(uuid())
  tenantId       String
  approvalCaseId String?
  channel        MessageChannel
  status         MessageStatus @default(QUEUED)
  toAddress      String
  templateKey    String?
  /// Provider message id once dispatched (prepared for Block 4).
  providerId     String?
  error          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  approvalCase ApprovalCase? @relation(fields: [approvalCaseId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@map("outbound_messages")
}

/// Reusable message/copy templates per tenant (Block 4). Seeded with defaults.
model MessageTemplate {
  id        String         @id @default(uuid())
  tenantId  String
  key       String
  channel   MessageChannel
  subject   String?
  body      String
  isDefault Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("message_templates")
}

// --- Integration readiness ---------------------------------------------------

/// Registered webhook receiver for integration (prepared in Block 3, delivery
/// with signing/retries in Block 5). `events` is a space-delimited allowlist of
/// DomainEventType values; empty means "all".
model WebhookEndpoint {
  id         String    @id @default(uuid())
  tenantId   String
  url        String
  /// Shared secret used to HMAC-sign deliveries (Block 5).
  secret     String
  /// Space-delimited DomainEventType allowlist; empty = subscribe to all.
  events     String    @default("")
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([tenantId])
  @@map("webhook_endpoints")
}

/// A single (attempted) webhook delivery. Block 7 adds real HTTP delivery with
/// HMAC signing and retry/backoff scheduled via `nextAttemptAt`.
model WebhookDelivery {
  id            String        @id @default(uuid())
  tenantId      String
  endpointId    String
  eventType     String
  payload       Json
  status        MessageStatus @default(QUEUED)
  attempts      Int           @default(0)
  lastError     String?
  /// When the delivery worker should next try this row (backoff schedule).
  nextAttemptAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([status, nextAttemptAt])
  @@index([endpointId])
  @@map("webhook_deliveries")
}

/// Persistent idempotency store (Block 7): replaces the in-memory map so retries
/// stay safe across restarts / multiple instances. Keyed per tenant.
model IdempotencyRecord {
  id          String   @id @default(uuid())
  tenantId    String
  key         String
  /// SHA-256 of the request payload; a reused key with a different body → 409.
  fingerprint String
  statusCode  Int
  /// The stored success response, replayed verbatim on retry.
  body        Json
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@unique([tenantId, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

/// Single-use, hashed verification token (Block 10) for member invitations and
/// password resets. Only the SHA-256 hash is stored — the raw token lives only
/// in the e-mailed link. `consumedAt`/`revokedAt`/`expiresAt` gate validity.
model VerificationToken {
  id          String                @id @default(uuid())
  tenantId    String
  type        VerificationTokenType
  /// SHA-256 of the opaque token; the raw token is never stored.
  tokenHash   String                @unique
  /// Target e-mail (invite recipient, or the resetting user's e-mail).
  email       String
  /// INVITE only: role to grant on acceptance.
  role        Role?
  /// PASSWORD_RESET only: the user being reset.
  userId      String?
  /// INVITE only: who sent the invitation.
  invitedById String?
  expiresAt   DateTime
  consumedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime              @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, type])
  @@index([email])
  @@index([expiresAt])
  @@map("verification_tokens")
}

/// In-app notification for a team member (Block 14). Generated when a case
/// changes in a way the recipient cares about (customer decision, callback,
/// expiry, assignment, internal note). Read state is per-notification.
model Notification {
  id             String           @id @default(uuid())
  tenantId       String
  /// Recipient user.
  userId         String
  type           NotificationType
  approvalCaseId String?
  /// Small denormalised payload for rendering (reference, subject, …).
  data           Json?
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvalCase ApprovalCase? @relation(fields: [approvalCaseId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

/// Internal note/comment on a case (Block 14). NEVER shown on the loginless
/// customer page — internal team collaboration only.
model CaseNote {
  id             String   @id @default(uuid())
  tenantId       String
  approvalCaseId String
  authorUserId   String?
  body           String
  createdAt      DateTime @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  approvalCase ApprovalCase @relation(fields: [approvalCaseId], references: [id], onDelete: Cascade)
  author       User?        @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([approvalCaseId, createdAt])
  @@map("case_notes")
}

/// API keys for machine-to-machine integration with existing garage software.
/// Prepared in Block 1; enforced in Block 5.
model ApiKey {
  id         String    @id @default(uuid())
  tenantId   String
  name       String
  /// SHA-256 hash of the secret; raw key shown once at creation only.
  keyHash    String    @unique
  /// Short non-secret prefix for identification in UI/logs, e.g. "saf_live_ab12".
  keyPrefix  String
  /// Space-delimited scopes, e.g. "approval-cases:read approval-cases:write".
  scopes     String    @default("")
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("api_keys")
}

/// A dictated voice capture used to pre-fill case creation (Block 21). Stored
/// so the capture is auditable; the audio itself is optional and, when kept,
/// lives in the storage driver (only its key is referenced here).
model VoiceCapture {
  id             String   @id @default(uuid())
  tenantId       String
  createdById    String?
  /// Transcribed text the draft parser consumed.
  transcript     String
  /// Effective transcription provider (e.g. "mock", "whisper").
  provider       String
  language       String?
  durationSec    Int?
  /// Storage key of the retained audio, if any. Null when audio wasn't kept.
  audioStorageKey String?
  createdAt      DateTime @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@map("voice_captures")
}

/// A named, reusable combination of approval-list filters (Block 28). Stored per
/// tenant (shared across the workspace); the filter columns mirror the allowed
/// list query params so applying a view just pre-composes those query params.
model SavedView {
  id            String   @id @default(uuid())
  tenantId      String
  createdById   String?
  name          String
  status        String?
  category      String?
  urgency       String?
  createdWithin String?
  assignee      String?
  createdAt     DateTime @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([tenantId, name])
  @@index([tenantId, createdAt])
  @@map("saved_views")
}
