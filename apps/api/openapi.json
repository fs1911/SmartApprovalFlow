          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/webhooks/deliver": {
      "post": {
        "summary": "Process pending webhook deliveries (signed, with retry/backoff)",
        "tags": [
          "webhooks"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/dev/webhook-sink": {
      "post": {
        "summary": "Dev-only webhook receiver (verifies signature)",
        "tags": [
          "webhooks"
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/reminders/run": {
      "post": {
        "summary": "Run the automatic reminder policy for this tenant",
        "tags": [
          "approval-cases"
        ],
        "description": "Evaluates every pending case against the configured reminder policy and sends the ones that are due. Safe to call repeatedly. Returns a summary of evaluated / sent / skipped.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/maintenance/cleanup": {
      "post": {
        "summary": "Run retention cleanup for this tenant",
        "tags": [
          "system"
        ],
        "description": "Removes expired idempotency records, terminal webhook deliveries past the retention window, and orphaned (never-uploaded) attachments. Safe to call repeatedly; returns the counts removed.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/uploads/local/{*}": {
      "put": {
        "summary": "Local storage: receive attachment bytes (dev signed-URL equivalent)",
        "tags": [
          "approval-cases"
        ],
        "description": "Accepts raw image bytes for a previously-registered attachment key.",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "*",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      },
      "get": {
        "summary": "Local storage: serve attachment bytes (dev download URL)",
        "tags": [
          "approval-cases"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "*",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/public/approvals/{token}": {
      "get": {
        "summary": "Read an approval request via its secure token (no login)",
        "tags": [
          "public"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "token",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/public/approvals/{token}/respond": {
      "post": {
        "summary": "Submit a customer decision (approve / decline / callback)",
        "tags": [
          "public"
        ],
        "description": "Loginless. Idempotent via the optional Idempotency-Key header so a double-tap on mobile does not create two decisions.",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "token",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/public/approvals/{token}/respond-items": {
      "post": {
        "summary": "Submit per-position customer decisions (individual approval)",
        "tags": [
          "public"
        ],
        "description": "Loginless. The customer decides each position; the case status is aggregated server-side (APPROVED / PARTIALLY_APPROVED / DECLINED / CALLBACK). Idempotent via the optional Idempotency-Key header.",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "token",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    }
  },
