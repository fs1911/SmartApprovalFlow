      "get": {
        "summary": "Read the current workspace settings and branding",
        "tags": [
          "workspace"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      },
      "patch": {
        "summary": "Update workspace settings and branding",
        "tags": [
          "workspace"
        ],
        "security": [
          {
            "bearerAuth": []
