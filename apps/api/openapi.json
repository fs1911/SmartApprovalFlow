    "/api/v1/approval-cases": {
      "get": {
        "summary": "List approval cases for the current tenant",
        "tags": [
          "approval-cases"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "cursor",
            "required": false
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "in": "query",
            "name": "limit",
            "required": false
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "status",
            "required": false
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "category",
            "required": false,
            "description": "Only cases with at least one position of this category (SAFETY|MAINTENANCE|REPAIR|DIAGNOSTIC|OTHER); validated server-side"
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "urgency",
            "required": false,
            "description": "Only cases of this urgency (LOW|MEDIUM|HIGH); validated server-side"
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "createdWithin",
            "required": false,
            "description": "Only cases created within this window (7d|30d|90d|365d)"
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "createdFrom",
            "required": false,
            "description": "Inclusive lower bound (YYYY-MM-DD); with createdFrom/createdTo overriding createdWithin"
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "createdTo",
            "required": false,
            "description": "Inclusive upper bound (YYYY-MM-DD); validated server-side"
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "assignee",
            "required": false,
            "description": "\"me\" limits to cases assigned to the caller"
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      },
      "post": {
        "summary": "Create an approval case",
        "tags": [
          "approval-cases"
        ],
        "description": "Validated against the shared Zod schema. Supports the `Idempotency-Key` header to make retries safe.",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "header",
            "name": "idempotency-key",
            "required": false
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
