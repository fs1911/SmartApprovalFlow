{
  "name": "@saf/api",
  "version": "0.1.0",
  "private": true,
  "description": "Klarwerk — public REST API (Fastify, OpenAPI-first).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "smoke": "tsx src/scripts/smoke.ts",
    "openapi:export": "tsx src/scripts/export-openapi.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^4.1.0",
    "@saf/db": "*",
    "@saf/types": "*",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "jose": "^6.2.4",
    "pino-pretty": "^11.2.2",
    "tsx": "^4.19.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "typescript": "^5.6.3"
  }
}
