# API environment (subset of the root .env.example — the single source).
# Runs fully with these defaults: console e-mail + local storage, no creds.
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
AUTH_JWT_SECRET=change-me-to-a-long-random-string
AUTH_SESSION_TTL=12h
# Onboarding token lifetimes in hours (Block 10): invite link / password reset.
INVITE_TTL_HOURS=168
PASSWORD_RESET_TTL_HOURS=2
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_approval_flow?schema=public

# Rate limiting + webhooks
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
RATE_LIMIT_PUBLIC_MAX=30
RATE_LIMIT_LOGIN_MAX=10
WEBHOOK_MAX_ATTEMPTS=5

# Reminder policy (Block 8): automatic reminders for still-pending cases.
# Triggered via POST /api/v1/reminders/run (no cron dependency).
REMINDER_ENABLED=true
REMINDER_FIRST_AFTER_HOURS=24
REMINDER_REPEAT_EVERY_HOURS=48
REMINDER_MAX=3

# Attachments (Block 8): max upload size in bytes (default 15 MB).
ATTACHMENT_MAX_BYTES=15728640

# Observability (Block 9): explicit log level (else derived from NODE_ENV),
# and error monitoring (`none` default | `sentry`/`http` need a DSN).
# LOG_LEVEL=info
ERROR_MONITORING=none
# TODO PROVIDER SETUP — ERROR_MONITORING_DSN=https://ingest.example/...

# Retention/cleanup (Block 9): thresholds for POST /api/v1/maintenance/cleanup.
RETENTION_WEBHOOK_DAYS=30
RETENTION_ORPHAN_ATTACHMENT_HOURS=24
# Erase terminal cases older than N months (0 = disabled, opt-in). Block 15.
RETENTION_CASE_MONTHS=0

# Billing (Block 11): `mock` (default, no account) | `stripe` (needs a key).
BILLING_PROVIDER=mock
BILLING_WEBHOOK_SECRET=whsec_dev_billing
# TODO PROVIDER SETUP — STRIPE_SECRET_KEY=sk_live_...

# Notifications: `console` (default, no creds) | `resend` (needs RESEND_API_KEY).
EMAIL_PROVIDER=console
EMAIL_FROM=freigabe@example-garage.ch
# TODO PROVIDER SETUP — RESEND_API_KEY=re_...

# Storage: `local` (default, no creds) | `supabase` | `r2`.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.uploads
# TODO PROVIDER SETUP — Supabase: SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY / SUPABASE_STORAGE_BUCKET
# TODO PROVIDER SETUP — R2: R2_ACCOUNT_ID / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY / R2_BUCKET
